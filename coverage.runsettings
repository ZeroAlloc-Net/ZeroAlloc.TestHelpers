<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage for CI: pass this file to dotnet test with the settings option. The Cobertura report goes to Codecov. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- The test project references src/ZeroAlloc.TestHelpers, so the helpers are measured
               in their own assembly. The test assembly holds only tests. -->
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <!-- Generated and compiler-generated code says nothing about test quality. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute,ObsoleteAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**/*.cs,**/*.g.cs,**/tests/**/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
