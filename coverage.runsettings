<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage for CI: pass this file to dotnet test with the settings option. The Cobertura report goes to Codecov. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- The test project compiles src/ZeroAlloc.TestHelpers/AllocationGate.cs as a linked
               file, so that code lives in the test assembly. Measure the test assembly, and
               leave out the test sources themselves by file. -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <!-- Generated and compiler-generated code says nothing about test quality. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute,ObsoleteAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**/*.cs,**/*.g.cs,**/tests/**/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
