<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The helpers are internal and reach the tests through InternalsVisibleTo in the src project.
         Referencing the project, rather than linking its source files in, keeps the code under test
         in the ZeroAlloc.TestHelpers assembly, which is where the coverage gate measures it. -->
    <ProjectReference Include="..\..\src\ZeroAlloc.TestHelpers\ZeroAlloc.TestHelpers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- GeneratorSnapshot's tests drive small generators of their own. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Snapshots are data, not code: every .verified.cs would otherwise be compiled and collide
       with the others, as in the consumer repos. -->
  <ItemGroup>
    <Compile Remove="**/*.verified.cs" />
    <Compile Remove="**/*.received.cs" />
    <None Include="**/*.verified.cs" />
  </ItemGroup>
</Project>
