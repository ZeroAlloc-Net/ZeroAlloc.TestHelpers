<Project>
  <!--
    The package ships three source files as contentFiles that compile into the consumer:
    AllocationGate.cs and TextSnapshot.cs, which need only the BCL, and GeneratorSnapshot.cs,
    which needs Microsoft.CodeAnalysis. A consumer without Roslyn, such as a Native AOT smoke app
    that only gates allocations or a test project that only snapshots strings, cannot compile the
    last one, so it is dropped from the compile unless the consumer can build it.

    ZeroAllocTestHelpersIncludeGeneratorSnapshot
      unset  auto: keep GeneratorSnapshot.cs only when Microsoft.CodeAnalysis.dll is among the
             resolved references. Generator test projects already reference Roslyn, so they
             keep it with no configuration.
      true   always compile it.
      false  never compile it.

    The check reads the resolved references rather than PackageReference items, so Roslyn that
    arrives transitively or through a project reference is seen too, and it looks for
    Microsoft.CodeAnalysis.dll because that is the assembly GeneratorSnapshot.cs uses;
    Microsoft.CodeAnalysis.CSharp always brings it along.

    AfterTargets puts the removal right after resolution, ahead of everything that hashes or
    reads Compile; BeforeTargets guarantees it has run by the time the compiler is invoked.
  -->
  <Target Name="_ZeroAllocTestHelpersSelectGeneratorSnapshot"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(ZeroAllocTestHelpersIncludeGeneratorSnapshot)' != 'true'">
    <ItemGroup>
      <_ZeroAllocTestHelpersRoslyn Include="@(ReferencePath)"
                                   Condition="'%(Filename)%(Extension)' == 'Microsoft.CodeAnalysis.dll'" />
      <_ZeroAllocTestHelpersGeneratorSnapshot Include="@(Compile)"
                                              Condition="'%(Filename)%(Extension)' == 'GeneratorSnapshot.cs' and '%(Compile.NuGetPackageId)' == 'ZeroAlloc.TestHelpers'" />
    </ItemGroup>
    <ItemGroup Condition="'$(ZeroAllocTestHelpersIncludeGeneratorSnapshot)' == 'false' or '@(_ZeroAllocTestHelpersRoslyn)' == ''">
      <Compile Remove="@(_ZeroAllocTestHelpersGeneratorSnapshot)" />
    </ItemGroup>
    <ItemGroup>
      <_ZeroAllocTestHelpersRoslyn Remove="@(_ZeroAllocTestHelpersRoslyn)" />
      <_ZeroAllocTestHelpersGeneratorSnapshot Remove="@(_ZeroAllocTestHelpersGeneratorSnapshot)" />
    </ItemGroup>
  </Target>

  <!--
    GeneratorSnapshot and TextSnapshot write their .verified.cs and .received.cs files into the
    Snapshots folder of the test project. The SDK's default globs compile them as source, so two
    snapshots of one generated type collide with CS0101. They are data, so they are dropped from
    the compile here and a consumer needs no item group of its own. Only the Snapshots folder
    directly under the project is touched, which is where the helpers write; a .cs file anywhere
    else is still source.

    ZeroAllocTestHelpersCompileSnapshotFiles
      unset  drop them.
      true   leave them in the compile, for a project that compiles its snapshots on purpose.
  -->
  <Target Name="_ZeroAllocTestHelpersExcludeSnapshotFiles"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(ZeroAllocTestHelpersCompileSnapshotFiles)' != 'true'">
    <ItemGroup>
      <Compile Remove="Snapshots/**/*.verified.cs" />
      <Compile Remove="Snapshots/**/*.received.cs" />
    </ItemGroup>
  </Target>
</Project>
